# Database
DATABASE_URL="postgresql://smartdoc:smartdoc@localhost:5432/smartdoc?schema=public"

# Redis (BullMQ). If unset or unreachable, in-process queue fallback is used.
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# App
APP_URL="http://localhost:3000"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_BYTES=20971520

# Yandex Cloud (optional — mock mode when unset)
YANDEX_FOLDER_ID=""
YANDEX_IAM_TOKEN=""
# Or API key auth:
YANDEX_API_KEY=""
YANDEX_OCR_URL="https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText"
YANDEX_GPT_URL="https://llm.api.cloud.yandex.net/foundationModels/v1/completion"
YANDEX_GPT_MODEL="yandexgpt-lite"

# Demo seed
SEED_ADMIN_EMAIL="admin@smartdoc.local"
SEED_ADMIN_PASSWORD="admin123456"
SEED_ORG_NAME="Demo Organization"

DATABASE_URL="file:./dev.db"

# Generate real random values for production, e.g.: openssl rand -hex 32
# `npm run start` (and the Docker image) refuse to boot in production with
# these placeholder values or with anything shorter than 32 characters.
JWT_SECRET="change-me"
SESSION_SECRET="change-me-to-a-long-random-string"

APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
